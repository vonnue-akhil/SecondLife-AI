# SecondLife AI server configuration. Copy to .env and fill in what you need.
# Every value is optional; blank values count as unset. Model credentials stay
# on the server and are never sent to the browser.

# Assessment provider: mock (default, scripted) or muse (Muse Spark).
AI_PROVIDER=mock

# Muse Spark host: meta (Meta Model API) or baseten (Muse Spark Open).
MUSE_HOST=meta

# Meta Model API. Serves Muse Spark (MUSE_HOST=meta), web search for local
# resources (whenever AI_PROVIDER=muse) and SAM 3.1 (SEGMENTATION_PROVIDER=sam3).
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3

# Baseten (MUSE_HOST=baseten)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026

# Damage segmentation: mock (default, bundled sample photos only) or sam3
# (SAM 3.1 on the Meta Model API, using MODEL_API_KEY).
SEGMENTATION_PROVIDER=mock
SAM_MODEL_ID=sam-3.1

# Speech to text for the mic button: Muse Voice Transcribe on the Meta Model API.
# On whenever AI_PROVIDER=muse and MODEL_API_KEY is set.
ASR_MODEL_ID=muse-voice-transcribe-1.0

# Maximum image upload size in MB (1-20).
MAX_UPLOAD_MB=8

# Maximum video clip size in MB (1-40). Clips must be MP4 or MOV and at most 30 seconds.
MAX_VIDEO_MB=20

# Partner programme (repair shops, points and rewards). Partners, wallets, handover and
# reward codes are saved in a JSON file in this folder; keep it on a persistent disk.
DATA_DIR=data
# PIN for the fictional demo partners, shown on the partner page so judges can try the
# flow. Demo partners only award demo points, which only buy demo rewards. Blank turns it off.
DEMO_PARTNER_PIN=demo-2026
# Token for approving partner registrations (GET/POST /api/v1/admin/...). Blank turns admin off.
ADMIN_TOKEN=

# Port for the API (and for the production server, which also serves the client).
PORT=3001
