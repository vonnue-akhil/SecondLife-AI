# SecondLife AI server configuration. Copy to .env and fill in what you need.
# Every value is optional; blank values count as unset. Model credentials stay
# on the server and are never sent to the browser.

# Assessment provider: mock (default, scripted) or muse (Muse Spark).
AI_PROVIDER=mock

# Muse Spark host: meta (Meta Model API) or baseten (Muse Spark Open).
MUSE_HOST=meta

# Meta Model API (MUSE_HOST=meta)
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3

# Baseten (MUSE_HOST=baseten)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026

# Damage segmentation: mock (default, bundled sample photos only) or sam3.
SEGMENTATION_PROVIDER=mock
# SAM 3 host: modal (sam3-modal/ app) or hosted (third-party endpoint).
SAM3_HOST=modal
SAM3_API_URL=
SAM3_API_KEY=

# Maximum image upload size in MB (1-20).
MAX_UPLOAD_MB=8

# Port for the API (and for the production server, which also serves the client).
PORT=3001
